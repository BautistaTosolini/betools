{
  "name": "betools",
  "version": "0.17.1",
  "private": true,
  "description": "Claude Code sessions in one window",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --linux deb",
    "build:web": "vite build -c web/vite.config.ts && vite build -c web/vite.server.config.ts",
    "start:web": "node web-dist/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c test/e2e/playwright.config.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/inter": "5.2.8",
    "@playwright/test": "1.65.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.17",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "author": {
    "name": "betools"
  },
  "homepage": "https://localhost/betools",
  "build": {
    "appId": "local.betools.app",
    "productName": "betools",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "resources/icon-512.png",
      "category": "Development",
      "executableName": "betools",
      "synopsis": "Claude Code sessions in one window",
      "maintainer": "betools <betools@localhost>",
      "syncDesktopName": true
    }
  },
  "desktopName": "betools.desktop"
}
